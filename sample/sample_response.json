  "summary": {
    "overview": "Photosynthesis is the process occurring in the chloroplasts of plant cells that converts light energy into chemical energy. It involves the absorption of specific light wavelengths and proceeds through distinct stages to produce glucose and oxygen.",
    "sections": [
      {
        "title": "General Process",
        "content": "Photosynthesis converts light energy into chemical energy within the chloroplasts of plant cells. Chlorophyll is used to absorb red and blue wavelengths of light."
      },
      {
        "title": "Light Reactions",
        "content": "During the light reactions, water is split through a process called photolysis, which releases oxygen. This stage also produces ATP and NADPH for use in the next stage."
      },
      {
        "title": "The Calvin Cycle",
        "content": "The Calvin Cycle uses RuBisCO to fix carbon dioxide into G3P. This G3P is then used to build glucose."
      },
      {
        "title": "Rate Factors",
        "content": "The rate of photosynthesis is affected by three primary factors: light intensity, CO2 concentration, and temperature."
      },
      {
        "title": "Overall Equation",
        "content": "The chemical equation for the process is 6CO2 + 6H2O + light -> C6H12O6 + 6O2."
      }
    ]
  },
  "key_terms": [
    {
      "term": "Photosynthesis",
      "definition": "The process of converting light energy into chemical energy in plant cells."
    },
    {
      "term": "Chloroplasts",
      "definition": "The organelles in plant cells where photosynthesis occurs."
    },
    {
      "term": "Chlorophyll",
      "definition": "A pigment that absorbs red and blue wavelengths of light."
    },
    {
      "term": "Photolysis",
      "definition": "The splitting of water to release oxygen during light reactions."
    },
    {
      "term": "ATP",
      "definition": "An energy molecule produced during the light reactions for use in the next stage."
    },
    {
      "term": "NADPH",
      "definition": "An energy molecule produced during the light reactions for use in the next stage."
    },
    {
      "term": "RuBisCO",
      "definition": "An enzyme that fixes carbon dioxide into G3P during the Calvin Cycle."
    },
    {
      "term": "G3P",
      "definition": "A molecule formed from carbon dioxide fixation that is used to build glucose."
    },
    {
      "term": "Glucose",
      "definition": "The sugar (C6H12O6) produced as the end result of the Calvin Cycle."
    }
  ],
